@@ -199,15 +209,82 @@
         KeyEvent ev = new KeyEvent(downTime, now, down ? KeyEvent.ACTION_DOWN : KeyEvent.ACTION_UP, code, 0);
         ev.setSource(InputDevice.SOURCE_KEYBOARD);
