+
+    void pulse(String k) { pulse(k, 72L); }
+
+    void pulse(String k, long holdMs) {
+        Integer code = keys.get(k);
+        if(code == null || inputHandler == null) return;
+        long now = SystemClock.uptimeMillis();
+        Long last = lastPulseTimes.get(code);
+        // One physical touch must never become two skill activations because of jitter/re-entry.
+        if(last != null && now - last < 110L) return;
+        lastPulseTimes.put(code, now);
+        Runnable old = pulseReleaseTasks.remove(code);
+        if(old != null) inputHandler.removeCallbacks(old);
+        if(keyDownTimes.containsKey(code)) dispatchKeyCode(code, false);
+        dispatchKeyCode(code, true);
+        Runnable release = () -> {
+            dispatchKeyCode(code, false);
+            pulseReleaseTasks.remove(code);
+        };
+        pulseReleaseTasks.put(code, release);
+        inputHandler.postDelayed(release, Math.max(45L, holdMs));
+    }
+
+    void hardResetInputs() {
+        if(controls != null) controls.releaseAll();
+        if(inputHandler != null) {
+            for(Runnable r : new ArrayList<>(pulseReleaseTasks.values())) inputHandler.removeCallbacks(r);
+        }
+        pulseReleaseTasks.clear();
+        for(Integer code : new ArrayList<>(keyDownTimes.keySet())) dispatchKeyCode(code, false);
+        keyDownTimes.clear();
+    }
+
+    boolean hasBundledGame() {
+        try(InputStream in = getAssets().open("game.swf")) {
+            byte[] h = new byte[3];
+            return in.read(h) == 3 && isSwfSig(h);
+        } catch(Exception e) { return false; }
+    }
+
+    long bundledGameLength() {
+        try(android.content.res.AssetFileDescriptor afd = getAssets().openFd("game.swf")) { return afd.getLength(); }
+        catch(Exception e) { return -1L; }
+    }
+
+    @Override protected void onPause() {
+        hardResetInputs();
+        if(web != null) web.onPause();
+        super.onPause();
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        hideSystem();
+        if(web != null) { web.onResume(); web.requestFocus(); }
+    }
+
+    @Override protected void onStop() {
+        hardResetInputs();
+        super.onStop();
+    }
+
+    @Override public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if(!hasFocus) hardResetInputs(); else hideSystem();
     }
 
